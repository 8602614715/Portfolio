# Copy this file to .env and fill in real values. Never commit .env.

# --- Required -------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# --- CORS -----------------------------------------------------------------
# Origin(s) of the deployed frontend. Comma-separate for several origins.
# Wildcards are rejected. In production every origin must be https://.
FRONTEND_URL=http://localhost:3000

# development | testing | production
# (production disables /docs and /redoc and enables HSTS)
ENVIRONMENT=development

# --- Optional (defaults shown) -------------------------------------------
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=16384
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
# Only set to true behind exactly one trusted reverse proxy that appends
# the real client IP to X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Tests (optional) -----------------------------------------------------
# Defaults to DATABASE_URL with "_test" appended to the database name.
# The database name MUST end in "_test": the suite migrates it up and down.
# TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/satyam_portfolio_test
